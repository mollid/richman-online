{
  "name": "richman-online",
  "private": true,
  "version": "0.1.0",
  "description": "大富翁4 风格联网多人棋盘游戏（原创美术，复刻玩法）",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm --filter @richman/server dev\" \"pnpm --filter @richman/client dev\"",
    "dev:client": "pnpm --filter @richman/client dev",
    "dev:server": "pnpm --filter @richman/server dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @richman/shared test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
